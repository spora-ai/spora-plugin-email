{
  "name": "spora-ai/spora-plugin-email",
  "description": "SMTP send + IMAP read for Spora agents.",
  "type": "spora-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.4.1",
    "spora-ai/spora-core": ">=0.18.0 <2.0.0",
    "symfony/event-dispatcher": "^8.0",
    "webklex/php-imap": "^6.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^5.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Spora\\Plugins\\Email\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Spora\\Plugins\\Email\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "test:parallel": "pest --parallel --processes=auto --max-batch-size=50",
    "test:coverage:clover": "XDEBUG_MODE=coverage pest --coverage-clover=coverage.xml --parallel --processes=auto --max-batch-size=50",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "lint": "php-cs-fixer fix --dry-run --diff --no-interaction"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "spora-ai/installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
